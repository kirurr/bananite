{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "outDir": "dist",

    /* Strictness: everything on. */
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },

  /* Volar: всё неизвестное в шаблоне (компоненты, пропсы, события,
     директивы, слоты) — ошибка, а не тихий resolveComponent в рантайме. */
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownProps": true,
    "checkUnknownEvents": true,
    "checkUnknownDirectives": true,
    "checkUnknownSlots": true,
    "strictVModel": true
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "*.ts", "*.d.ts"],

  /* Внимание: exclude убирает файлы только из корневого списка программы.
     Компоненты Volt импортируются нашими экранами, поэтому TS всё равно
     затягивает их транзитивно — реальное исключение из typecheck делает
     `// @ts-nocheck` в шапке каждого файла src/renderer/components/volt/*.
     Для eslint и prettier исключения живут в eslint.config.mjs и .prettierignore. */
  "exclude": ["node_modules", ".vite", "out", "dist", "./src/renderer/components/volt"]
}
